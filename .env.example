# Copy this file to .env.local and fill in your values

# Backend API URL (FastAPI)
NEXT_PUBLIC_BACKEND_URL=https://api.sehti.online

# Meta Pixel (browser-side only — never put ACCESS_TOKEN here)
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel (browser-side only — never put ACCESS_TOKEN here)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
