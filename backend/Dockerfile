FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY . .

# Make entrypoint executable
RUN chmod +x entrypoint.sh

# Convert Easypanel build args to runtime env vars
ARG APP_ENV
ARG APP_NAME
ARG FRONTEND_URL
ARG BACKEND_URL
ARG DATABASE_URL
ARG GOOGLE_SHEETS_WEBHOOK_URL
ARG META_PIXEL_ID
ARG META_ACCESS_TOKEN
ARG META_TEST_EVENT_CODE
ARG TIKTOK_PIXEL_CODE
ARG TIKTOK_ACCESS_TOKEN
ARG TIKTOK_TEST_EVENT_CODE
ARG CORS_ORIGINS
ARG TEST_PHONE_NUMBER

ENV APP_ENV=${APP_ENV}
ENV APP_NAME=${APP_NAME}
ENV FRONTEND_URL=${FRONTEND_URL}
ENV BACKEND_URL=${BACKEND_URL}
ENV DATABASE_URL=${DATABASE_URL}
ENV GOOGLE_SHEETS_WEBHOOK_URL=${GOOGLE_SHEETS_WEBHOOK_URL}
ENV META_PIXEL_ID=${META_PIXEL_ID}
ENV META_ACCESS_TOKEN=${META_ACCESS_TOKEN}
ENV META_TEST_EVENT_CODE=${META_TEST_EVENT_CODE}
ENV TIKTOK_PIXEL_CODE=${TIKTOK_PIXEL_CODE}
ENV TIKTOK_ACCESS_TOKEN=${TIKTOK_ACCESS_TOKEN}
ENV TIKTOK_TEST_EVENT_CODE=${TIKTOK_TEST_EVENT_CODE}
ENV CORS_ORIGINS=${CORS_ORIGINS}
ENV TEST_PHONE_NUMBER=${TEST_PHONE_NUMBER}

EXPOSE 8000

ENTRYPOINT ["./entrypoint.sh"]
