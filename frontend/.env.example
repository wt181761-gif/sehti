# SEHTI Frontend Environment
# Copy this file to .env.local for local development.
# In production, add these values in your hosting/EasyPanel frontend service.

# Website URL
NEXT_PUBLIC_SITE_URL=https://sehti.online

# FastAPI backend URL
NEXT_PUBLIC_BACKEND_URL=https://api.sehti.online

# Meta Pixel browser ID only.
# Never put META_ACCESS_TOKEN in the frontend.
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel browser ID only.
# Never put TIKTOK_ACCESS_TOKEN in the frontend.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Optional debugging
NEXT_PUBLIC_TRACKING_DEBUG=false
